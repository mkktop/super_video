{
  "name": "super-video-app",
  "version": "0.3.1",
  "description": "super_video 桌面端 —— AI 视频超分",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.supervideo.app",
    "productName": "super_video",
    "directories": {
      "output": "../dist-app"
    },
    "publish": {
      "provider": "github",
      "owner": "mkktop",
      "repo": "super_video",
      "releaseType": "release"
    },
    "files": [
      "out/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README_*.md,.md}",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/sidecar",
        "to": "sidecar"
      },
      {
        "from": "../bin",
        "to": "bin"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "super_video_${version}_setup.exe",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "license": "build/license_zh.rtf",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "~5.8.3",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "naive-ui": "^2.45.2",
    "vue": "^3.5.41"
  }
}
